# FTM-CODER-AI Environment Variables
# Copy this to .env and fill in your values

# AgentRouter API Key (get from https://agentrouter.org/console/token)
AGENTROUTER_API_KEY=sk-your-key-here

# AI Model (default: gpt-5)
AGENT_MODEL=gpt-5

# Server Port (set automatically by Replit)
PORT=8080

# Database (set automatically by Replit)
DATABASE_URL=postgresql://user:password@localhost:5432/ftm_coder
